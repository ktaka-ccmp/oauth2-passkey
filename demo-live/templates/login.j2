<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link rel="stylesheet" href="{{o2p_route_prefix}}/user/o2p-base.css">
    {% if let Some(css_url) = custom_css_url %}
    <link rel="stylesheet" href="{{css_url}}">
    {% endif %}
    <script src="{{o2p_route_prefix}}/oauth2/oauth2.js"></script>
    <script src="{{o2p_route_prefix}}/passkey/passkey.js"></script>
    <script>
        const O2P_ROUTE_PREFIX = '{{o2p_route_prefix}}';
        const csrfToken = "_NOT_SET_";
    </script>
    <style>
        .login-page {
            background: var(--o2p-background, #f9fafb) !important;
        }
        .login-card {
            position: relative;
            padding: 40px 36px !important;
            max-width: 420px !important;
            border: 1px solid var(--o2p-border, #e5e7eb);
        }
        .login-card h1 {
            margin-bottom: 12px !important;
        }
        .login-card .subtitle {
            margin-bottom: 32px !important;
        }
        .auth-buttons {
            gap: 16px !important;
        }
        .btn-google {
            background-color: var(--o2p-oauth2, #6366f1);
            color: white;
            padding: 12px 16px;
        }
        .btn-google:hover {
            background-color: var(--o2p-oauth2-hover, #4f46e5);
        }
        .btn-passkey-alt {
            background-color: var(--o2p-passkey, #818cf8);
            color: white;
            padding: 12px 16px;
        }
        .btn-passkey-alt:hover {
            background-color: var(--o2p-passkey-hover, #6366f1);
        }
        .btn-hint {
            display: block;
            text-align: center;
            font-size: 0.8em;
            color: var(--o2p-text-secondary, #6b7280);
            margin-top: 4px;
        }
        .github-corner {
            position: absolute;
            top: 12px;
            right: 12px;
            color: var(--o2p-text-secondary, #6b7280);
            transition: color 0.15s;
        }
        .github-corner:hover { color: var(--o2p-text, #111827); }
    </style>
</head>

<body class="login-page">
    <div class="login-card">
        <a href="https://github.com/ktaka-ccmp/oauth2-passkey" target="_blank" rel="noopener" class="github-corner" title="View source on GitHub">
            <svg viewBox="0 0 16 16" width="32" height="32" fill="currentColor"><path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"/></svg>
        </a>
        <h1>Welcome</h1>
        <p class="subtitle">Sign in or create an account</p>

        <div class="auth-section">
            <div class="auth-buttons">
                <div>
                    <button class="btn btn-google btn-block" onclick="oauth2.openPopup('create_user_or_login')">
                        Register / Sign in with Google
                    </button>
                    <span class="btn-hint">New here? Start here</span>
                </div>
                <div>
                    <button class="btn btn-passkey-alt btn-block" onclick="startAuthentication(false)">
                        Sign in with Passkey
                    </button>
                    <span class="btn-hint">Already registered a passkey?</span>
                </div>
            </div>
        </div>
    </div>
</body>

</html>

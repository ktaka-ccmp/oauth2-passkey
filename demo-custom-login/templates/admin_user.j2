<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin: User Detail - Custom Login Demo</title>
    <script>
        const O2P_ROUTE_PREFIX = '{{o2p_route_prefix}}';
        const csrfToken = '{{csrf_token}}';
        const targetUserId = '{{target_user_id}}';
    </script>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            max-width: 800px;
            margin: 0 auto;
            padding: 40px 20px;
            background: #f5f5f5;
        }

        .container {
            background: white;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

        h1 {
            color: #333;
            margin-bottom: 8px;
        }

        h2 {
            color: #555;
            font-size: 18px;
            margin-top: 32px;
            margin-bottom: 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid #667eea;
            padding-bottom: 8px;
        }

        .subtitle {
            color: #666;
            margin-bottom: 24px;
        }

        .admin-badge {
            background: #667eea;
            color: white;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 12px;
            font-weight: 600;
            margin-left: 8px;
        }

        .user-info {
            background: #e3f2fd;
            padding: 20px;
            border-radius: 8px;
            margin: 20px 0;
        }

        .user-info p {
            margin: 8px 0;
            color: #333;
        }

        .user-info strong {
            color: #1565c0;
            min-width: 120px;
            display: inline-block;
        }

        .user-info-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .credential-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .credential-item {
            background: #f8f9fa;
            padding: 16px;
            border-radius: 8px;
            margin-bottom: 12px;
            border-left: 4px solid #667eea;
        }

        .credential-item.oauth2 {
            border-left-color: #4285f4;
        }

        .credential-item.passkey {
            border-left-color: #34a853;
        }

        .credential-item p {
            margin: 4px 0;
            color: #555;
            font-size: 14px;
        }

        .credential-item .label {
            font-weight: 600;
            color: #333;
        }

        .credential-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .empty-message {
            color: #888;
            font-style: italic;
            padding: 16px;
            background: #f8f9fa;
            border-radius: 8px;
        }

        .btn {
            display: inline-block;
            padding: 8px 16px;
            text-decoration: none;
            border-radius: 6px;
            font-weight: 500;
            transition: background 0.2s;
            cursor: pointer;
            border: none;
            font-size: 14px;
        }

        .btn-large {
            padding: 12px 24px;
            font-size: 16px;
        }

        .btn-primary {
            background: #667eea;
            color: white;
        }

        .btn-primary:hover {
            background: #5a6fd6;
        }

        .btn-secondary {
            background: #f0f0f0;
            color: #333;
        }

        .btn-secondary:hover {
            background: #e0e0e0;
        }

        .btn-danger {
            background: #dc3545;
            color: white;
        }

        .btn-danger:hover {
            background: #c82333;
        }

        .btn-success {
            background: #28a745;
            color: white;
        }

        .btn-success:hover {
            background: #218838;
        }

        .btn-warning {
            background: #ffc107;
            color: #333;
        }

        .btn-warning:hover {
            background: #e0a800;
        }

        .btn-small {
            font-size: 12px;
            padding: 4px 10px;
        }

        .action-buttons {
            display: flex;
            gap: 8px;
        }

        .ml-10 {
            margin-left: 10px;
        }

        .first-user-note {
            font-size: 12px;
            color: #888;
            margin-left: 8px;
        }
    </style>
</head>

<body>
    <div class="container">
        <h1>
            Admin: User Detail
            {% if target_is_admin %}
            <span class="admin-badge">Admin</span>
            {% if target_is_first_user %}
            <span class="first-user-note">(First User - Protected)</span>
            {% endif %}
            {% endif %}
        </h1>
        <p class="subtitle">Manage user credentials and account</p>

        <!-- User Information -->
        <div class="user-info">
            <div class="user-info-row">
                <div>
                    <p><strong>User ID:</strong> {{target_user_id}}</p>
                    <p><strong>Account:</strong> {{target_user_account}}</p>
                    <p><strong>Display Name:</strong> {{target_user_label}}</p>
                    <p><strong>Created:</strong> {{target_created_at}}</p>
                </div>
                <div class="action-buttons">
                    {% if target_is_first_user %}
                    <!-- First user cannot be modified -->
                    {% else %}
                    {% if target_is_admin %}
                    <button class="btn btn-warning" onclick="toggleAdmin(false)">Demote</button>
                    {% else %}
                    <button class="btn btn-success" onclick="toggleAdmin(true)">Promote</button>
                    {% endif %}
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Passkey Credentials -->
        <h2>
            <span>Passkey Credentials</span>
        </h2>
        {% if passkeys.is_empty() %}
        <p class="empty-message">No passkeys registered</p>
        {% else %}
        <ul class="credential-list">
            {% for passkey in passkeys %}
            <li class="credential-item passkey">
                <p><span class="label">Name:</span> {{passkey.user_name}}</p>
                <p><span class="label">Display Name:</span> {{passkey.user_display_name}}</p>
                <div class="credential-row">
                    <span><span class="label">Created:</span> {{passkey.created_at}}</span>
                    <button class="btn btn-danger btn-small" onclick="deletePasskey('{{passkey.credential_id}}')">Delete</button>
                </div>
            </li>
            {% endfor %}
        </ul>
        {% endif %}

        <!-- OAuth2 Accounts -->
        <h2>
            <span>OAuth2 Accounts</span>
        </h2>
        {% if oauth2_accounts.is_empty() %}
        <p class="empty-message">No OAuth2 accounts linked</p>
        {% else %}
        <ul class="credential-list">
            {% for account in oauth2_accounts %}
            <li class="credential-item oauth2">
                <p><span class="label">Provider:</span> {{account.provider}}</p>
                <p><span class="label">Name:</span> {{account.name}}</p>
                <div class="credential-row">
                    <span><span class="label">Email:</span> {{account.email}}</span>
                    <button class="btn btn-danger btn-small" onclick="unlinkOAuth2('{{account.provider}}', '{{account.provider_user_id}}')">Unlink</button>
                </div>
            </li>
            {% endfor %}
        </ul>
        {% endif %}

        <!-- Danger Zone -->
        {% if target_is_first_user %}
        <!-- First user cannot be deleted -->
        {% else %}
        <h2 style="border-bottom-color: #dc3545;">
            <span>Danger Zone</span>
        </h2>
        <p style="color: #666; margin-bottom: 16px;">Permanently delete this user and all associated data.</p>
        <button class="btn btn-danger" onclick="deleteUser()">Delete User</button>
        {% endif %}

        <!-- Navigation -->
        <div style="margin-top: 32px; padding-top: 20px; border-top: 1px solid #eee;">
            <a href="/admin" class="btn btn-primary btn-large">Back to Admin Panel</a>
            <a href="/" class="btn btn-secondary btn-large ml-10">Home</a>
        </div>
    </div>

    <script>
        // Toggle admin status
        function toggleAdmin(makeAdmin) {
            const action = makeAdmin ? 'promote to admin' : 'demote from admin';
            if (!confirm(`Are you sure you want to ${action} this user?`)) return;

            fetch(`${O2P_ROUTE_PREFIX}/admin/update_admin_status`, {
                method: 'PUT',
                headers: {
                    'X-CSRF-Token': csrfToken,
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    user_id: targetUserId,
                    is_admin: makeAdmin
                })
            })
            .then(response => {
                if (response.ok) {
                    window.location.reload();
                } else {
                    response.text().then(text => alert('Failed: ' + text));
                }
            })
            .catch(error => {
                alert('Error: ' + error.message);
            });
        }

        // Delete passkey (admin)
        function deletePasskey(credentialId) {
            if (!confirm('Are you sure you want to delete this passkey?')) return;

            fetch(`${O2P_ROUTE_PREFIX}/admin/delete_passkey_credential/${credentialId}`, {
                method: 'DELETE',
                headers: {
                    'X-CSRF-Token': csrfToken,
                    'Content-Type': 'application/json'
                }
            })
            .then(response => {
                if (response.ok) {
                    window.location.reload();
                } else {
                    response.text().then(text => alert('Failed: ' + text));
                }
            })
            .catch(error => {
                alert('Error: ' + error.message);
            });
        }

        // Unlink OAuth2 account (admin)
        function unlinkOAuth2(provider, providerUserId) {
            if (!confirm('Are you sure you want to unlink this OAuth2 account?')) return;

            fetch(`${O2P_ROUTE_PREFIX}/admin/delete_oauth2_account/${provider}/${providerUserId}`, {
                method: 'DELETE',
                headers: {
                    'X-CSRF-Token': csrfToken,
                    'Content-Type': 'application/json'
                }
            })
            .then(response => {
                if (response.ok) {
                    window.location.reload();
                } else {
                    response.text().then(text => alert('Failed: ' + text));
                }
            })
            .catch(error => {
                alert('Error: ' + error.message);
            });
        }

        // Delete user (admin)
        function deleteUser() {
            if (!confirm('Are you sure you want to delete this user?')) return;
            if (!confirm('This will permanently delete all their data. Are you absolutely sure?')) return;

            fetch(`${O2P_ROUTE_PREFIX}/admin/delete_user`, {
                method: 'DELETE',
                headers: {
                    'X-CSRF-Token': csrfToken,
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ user_id: targetUserId })
            })
            .then(response => {
                if (response.ok) {
                    window.location.href = '/admin';
                } else {
                    response.text().then(text => alert('Failed: ' + text));
                }
            })
            .catch(error => {
                alert('Error: ' + error.message);
            });
        }
    </script>
</body>

</html>

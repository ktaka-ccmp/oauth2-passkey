# Cross-Origin Same-Site Demo Configuration
# This demonstrates Pattern 2: Auth Server + Separate Resource API

######################################
### Architecture ###
######################################
#
# Auth Server (auth.example.local:3000)
#   - Frontend (static files)
#   - oauth2_passkey (authentication endpoints)
#   - Issues Cookie with Domain=.example.local
#
# Resource API (api.example.local:3001)
#   - Business logic endpoints
#   - Validates Cookie issued by Auth Server
#   - Requires CORS for cross-origin requests
#

######################################
### Auth Server Configuration ###
######################################

# Auth server origin (where authentication happens)
# This is also where the frontend is served from
ORIGIN='http://auth.example.local:3000'

# Port configuration (optional, defaults shown)
# AUTH_PORT=3000
# API_PORT=3001

######################################
### Session Configuration ###
######################################

# Session authentication mode
SESSION_AUTH_MODE=cookie

# Cookie domain - enables cross-subdomain cookie sharing
# The leading dot allows the cookie to be shared across all subdomains
# This is what allows the Resource API to validate sessions!
SESSION_COOKIE_DOMAIN='.example.local'

# Cookie name - IMPORTANT: Do NOT use __Host- prefix with Domain attribute
# __Host- prefix requires: no Domain, Path=/, Secure
# Since we need Domain for cross-subdomain, we use a name without __Host-
SESSION_COOKIE_NAME='SessionId'

######################################
### CORS Configuration ###
######################################

# Allow requests from the auth server origin (where frontend runs)
# Resource API needs this to accept cross-origin requests
CORS_ALLOWED_ORIGINS='http://auth.example.local:3000'

# Enable credentials (cookies) for cross-origin requests
# This allows the Resource API to receive the session cookie
CORS_ALLOW_CREDENTIALS=true

######################################
### Storage Configuration ###
######################################

# Use in-memory storage for demo purposes
# Both servers share the same storage configuration
GENERIC_CACHE_STORE_TYPE=memory
GENERIC_DATA_STORE_TYPE=sqlite
GENERIC_DATA_STORE_URL='sqlite::memory:'

######################################
### Optional Configuration ###
######################################

# Route prefix for authentication endpoints
O2P_ROUTE_PREFIX='/o2p'

# Passkey configuration
PASSKEY_AUTHENTICATOR_ATTACHMENT='platform'
PASSKEY_RESIDENT_KEY='required'
PASSKEY_REQUIRE_RESIDENT_KEY=true
PASSKEY_USER_VERIFICATION='discouraged'

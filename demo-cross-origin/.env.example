# Cross-Origin Same-Site Demo Configuration (Pattern 2)
#
# This demo shows how a separate API server can validate session cookies
# issued by the Auth Server, using cross-subdomain cookie sharing.

######################################
### Architecture ###
######################################
#
# Auth Server (AUTH_PORT, default 3000)
#   - Frontend UI
#   - OAuth2 + Passkey authentication
#   - Issues Cookie with Domain=SESSION_COOKIE_DOMAIN
#
# API server (API_PORT, default 3001)
#   - Business logic endpoints
#   - Validates Cookie issued by Auth Server
#   - Requires CORS for cross-origin requests
#

######################################
### Server Configuration ###
######################################

# Auth server origin (used for CSRF validation and redirects)
ORIGIN='http://auth.example.local:3000'

# API server origin (frontend makes cross-origin requests here)
API_ORIGIN='http://api.example.local:3001'

# Port configuration (optional)
# AUTH_PORT=3000
# API_PORT=3001

######################################
### OAuth2 Configuration ###
######################################

# Google OAuth2 credentials (required for OAuth2 login)
# Get these from https://console.cloud.google.com/apis/credentials
OAUTH2_GOOGLE_CLIENT_ID='your-client-id.apps.googleusercontent.com'
OAUTH2_GOOGLE_CLIENT_SECRET='your-client-secret'

# OIDC discovery endpoint
OAUTH2_ISSUER_URL='https://accounts.google.com'

######################################
### Session Configuration ###
######################################

# Session authentication mode
SESSION_AUTH_MODE=cookie

# Cookie domain - enables cross-subdomain cookie sharing
# This is the key to Pattern 2: the leading dot allows the cookie
# to be shared between auth.example.local and api.example.local
SESSION_COOKIE_DOMAIN='.example.local'

# Cookie name - IMPORTANT: Do NOT use __Host- prefix with Domain attribute
# __Host- prefix requires: no Domain, Path=/, Secure
SESSION_COOKIE_NAME='SessionId'

######################################
### CORS Configuration ###
######################################

# Allow cross-origin requests from Auth Server to API server
# The frontend runs on Auth Server, so we allow that origin
CORS_ALLOWED_ORIGINS='http://auth.example.local:3000'

# Enable credentials (cookies) for cross-origin requests
CORS_ALLOW_CREDENTIALS=true

######################################
### Storage Configuration ###
######################################

# Use in-memory storage for demo purposes
# Note: Both servers must share the same storage for session validation!
GENERIC_CACHE_STORE_TYPE=memory
GENERIC_DATA_STORE_TYPE=sqlite
GENERIC_DATA_STORE_URL='sqlite::memory:'

######################################
### Optional Configuration ###
######################################

# Route prefix for authentication endpoints
O2P_ROUTE_PREFIX='/o2p'

# Passkey configuration
PASSKEY_AUTHENTICATOR_ATTACHMENT='platform'
PASSKEY_RESIDENT_KEY='required'
PASSKEY_REQUIRE_RESIDENT_KEY=true
PASSKEY_USER_VERIFICATION='discouraged'

# Custom CSS theme (optional)
# O2P_CUSTOM_CSS_URL='/o2p/themes/theme-material.css'

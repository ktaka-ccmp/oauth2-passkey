<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cross-Origin Demo</title>
    <link rel="stylesheet" href="{{prefix}}/user/o2p-base.css">
    {% if let Some(css_url) = custom_css_url %}
    <link rel="stylesheet" href="{{css_url}}">
    {% endif %}
    <style>
        .status-badge {
            display: inline-block;
            padding: 0.25rem 0.75rem;
            border-radius: var(--o2p-radius-sm);
            font-size: 0.875rem;
            font-weight: 600;
        }
        .status-badge.authenticated {
            background: #dcfce7;
            color: #166534;
        }
        .status-badge.not-authenticated {
            background: #fef3c7;
            color: #92400e;
        }
        .api-buttons {
            display: flex;
            gap: var(--o2p-space-sm);
            flex-wrap: wrap;
        }
        .log-container {
            background: #1e293b;
            color: #e2e8f0;
            padding: var(--o2p-space-md);
            border-radius: var(--o2p-radius-md);
            font-family: monospace;
            font-size: 0.8rem;
            max-height: 250px;
            overflow-y: auto;
        }
        .log-entry { margin-bottom: 0.5rem; padding-bottom: 0.5rem; border-bottom: 1px solid #334155; }
        .log-entry:last-child { margin-bottom: 0; padding-bottom: 0; border-bottom: none; }
        .log-time { color: #94a3b8; }
        .log-success { color: #4ade80; }
        .log-error { color: #f87171; }
        .log-info { color: #60a5fa; }
        .user-info {
            color: var(--o2p-text-secondary);
            font-size: 0.875rem;
        }
    </style>
</head>
<body>
<div class="container">
    <div class="page-header">
        <h1>Cross-Origin Demo</h1>
        <nav>
            <a href="/">Home</a>
            <a href="{{prefix}}/user/account">Account</a>
        </nav>
        <div class="header-buttons">
            {% if authenticated %}
            <a href="{{prefix}}/user/logout?redirect=/" class="btn btn-secondary btn-sm">Logout</a>
            {% else %}
            <a href="{{prefix}}/user/login" class="btn btn-primary btn-sm">Login</a>
            {% endif %}
        </div>
    </div>

    <div class="section">
        <div class="section-header">
            <h2 class="section-title">Auth Server</h2>
            <code style="font-size: 0.75rem; color: var(--o2p-text-secondary);">{{auth_origin}}</code>
        </div>
        {% if authenticated %}
        <div class="item">
            <span class="status-badge authenticated">Authenticated</span>
            <span class="user-info">{{user_account}}</span>
        </div>
        {% else %}
        <div class="item">
            <span class="status-badge not-authenticated">Not logged in</span>
            <a href="{{prefix}}/user/login" class="btn btn-primary btn-sm" style="margin-left: var(--o2p-space-sm);">Login</a>
        </div>
        {% endif %}
    </div>

    <div class="section">
        <div class="section-header">
            <h2 class="section-title">API Server</h2>
            <code style="font-size: 0.75rem; color: var(--o2p-text-secondary);">{{api_origin}}</code>
        </div>
        <p style="color: var(--o2p-text-secondary); margin-bottom: var(--o2p-space-md); font-size: 0.875rem;">
            Call the API server (Cross-Origin) to verify session cookie sharing.
        </p>
        <div class="api-buttons">
            <button class="btn btn-secondary" onclick="callApi('/api/info')">GET /api/info</button>
            <button class="btn btn-secondary" onclick="callApi('/api/protected')">GET /api/protected</button>
        </div>
    </div>

    <div class="section">
        <div class="section-header">
            <h2 class="section-title">Response Log</h2>
        </div>
        <div class="log-container" id="log">Ready to test...</div>
    </div>
</div>

<script>
    const API_ORIGIN = '{{api_origin}}';

    function log(message, type = 'info') {
        const logEl = document.getElementById('log');
        const time = new Date().toLocaleTimeString();
        const className = 'log-' + type;
        const entry = document.createElement('div');
        entry.className = 'log-entry';
        entry.innerHTML = `<span class="log-time">[${time}]</span> <span class="${className}">${message}</span>`;
        logEl.insertBefore(entry, logEl.firstChild);
    }

    async function callApi(path) {
        const url = `${API_ORIGIN}${path}`;
        log(`GET ${url}`, 'info');

        try {
            const response = await fetch(url, { credentials: 'include' });
            const data = await response.json().catch(() => null);

            if (response.ok && data?.authenticated) {
                log(`${response.status} OK - Authenticated as: ${data.user?.account}`, 'success');
            } else if (response.ok) {
                log(`${response.status} OK - Not authenticated`, 'info');
            } else {
                log(`${response.status} ${response.statusText}`, 'error');
            }
        } catch (error) {
            log(`Error: ${error.message}`, 'error');
        }
    }
</script>
</body>
</html>

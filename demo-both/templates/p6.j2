<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Demo: Form CSRF Validation</title>
    <link rel="stylesheet" href="{{prefix}}/user/o2p-base.css">
    {% if let Some(css_url) = custom_css_url %}
    <link rel="stylesheet" href="{{css_url}}">
    {% endif %}
    <style>
        .demo-description { color: var(--o2p-text-secondary); margin-bottom: var(--o2p-space-md); }
        .result {
            padding: var(--o2p-space-md);
            border-radius: var(--o2p-radius-md);
            margin-bottom: var(--o2p-space-md);
        }
        .result.success {
            background-color: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }
        .result.error {
            background-color: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }
        .forms-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: var(--o2p-space-md);
        }
        @media (max-width: 600px) {
            .forms-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
<div class="container">
    <div class="page-header">
        <h1>p6: Form CSRF Validation</h1>
        <nav>
            <a href="/">Home</a>
            <a href="/p1">p1</a>
            <a href="/p2">p2</a>
            <a href="/p3">p3</a>
            <a href="/p4">p4</a>
            <a href="/p5">p5</a>
            <a href="/p6">p6</a>
            <a href="/nested/p3">nested/p3</a>
            <a href="{{prefix}}/user/account">Account</a>
        </nav>
        <div class="header-buttons">
            <a href="{{prefix}}/user/logout?redirect=/" class="btn btn-secondary btn-sm">Logout</a>
        </div>
    </div>

    <div class="section">
        <div class="section-header">
            <h2 class="section-title">About This Page</h2>
        </div>
        <p class="demo-description">
            Form submission with CSRF token in a hidden field.
            Server verifies the token using constant-time comparison (<code>subtle::ConstantTimeEq</code>).
        </p>
    </div>

    {% match post_result_message %}
    {% when Some with (message) %}
        <div class="result {% if post_success %}success{% else %}error{% endif %}">
            <h3>Submission Result:</h3>
            <p>{{ message }}</p>
        </div>
    {% when None %}
    {% endmatch %}

    <div class="section">
        <div class="forms-grid">
            <div class="item">
                <h3>With CSRF Token</h3>
                <form method="POST" action="">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                    <div class="form-group">
                        <input type="text" name="message" value="Hello with CSRF token!" class="form-input">
                    </div>
                    <button type="submit" class="btn btn-primary">Submit with CSRF</button>
                </form>
            </div>
            <div class="item">
                <h3>Without CSRF Token</h3>
                <form method="POST" action="">
                    <div class="form-group">
                        <input type="text" name="message" value="Hello without CSRF token!" class="form-input">
                    </div>
                    <button type="submit" class="btn btn-danger">Submit without CSRF</button>
                </form>
            </div>
        </div>
    </div>
</div>
</body>
</html>

<!DOCTYPE html>
<html>
<head>
    <title>User Detail</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- External CSS file -->
    <link rel="stylesheet" href="{{o2p_route_prefix}}/user/o2p-base.css">
    {% if let Some(css_url) = custom_css_url %}
    <link rel="stylesheet" href="{{css_url}}">
    {% endif %}
</head>
<body>
<div class="container">
    <div class="page-header">
        <h1>User Detail</h1>
        <nav>
            <a href="{{o2p_route_prefix}}/admin/index">Admin Panel</a>
            <a href="{{o2p_route_prefix}}/user/account">My Account</a>
        </nav>
        <div class="header-buttons">
            <button onclick="DeleteAccount()" class="action-button delete-button">Delete Account</button>
        </div>
    </div>

    <!-- User Information Section -->
    <div class="section">
        <div class="section-header">
            <h2 class="section-title">User Information</h2>
        </div>
        <div class="item" id="user-info-display">
            <div class="item-detail"><strong>User ID:</strong> {{ user.id }}</div>
            <div class="item-detail">
                <strong>Is Admin:</strong>
                {% if user.sequence_number.is_some() && user.sequence_number.unwrap_or(0) == 1 %}
                    <span>{{ user.is_admin }} (First User)</span>
                {% else %}
                    <button onclick="toggleAdminStatus('{{ user.id }}', {{ user.is_admin }})">
                        <span id="admin-status-{{ user.id }}">{{ user.is_admin }}</span>
                    </button>
                {% endif %}
            </div>
            <div class="item-detail"><strong>Account:</strong> {{ user.account }}</div>
            <div class="item-detail"><strong>Label:</strong> {{ user.label }}</div>
            <div class="item-detail"><strong>Created:</strong> {{ user.created_at }}</div>
            <div class="item-detail"><strong>Updated:</strong> {{ user.updated_at }}</div>
            <div class="item-detail">
                <strong>Active Sessions:</strong>
                <span id="session-count">...</span>
                <button id="force-logout-btn" onclick="forceLogout('{{ user.id }}')" class="action-button delete-button" style="display: none; margin-left: 10px;">Force Logout</button>
            </div>
        </div>
    </div>

    <!-- Passkey Credentials Section -->
    <div class="section">
        <div class="section-header">
            <h2 class="section-title">Passkey Credentials</h2>
        </div>
        {% if passkey_credentials.is_empty() %}
            <p>You don't have any passkey credentials yet.</p>
        {% else %}
            {% for credential in passkey_credentials %}
                <div class="item passkey" data-credential-id="{{ credential.credential_id }}">
                    <div class="item-detail has-icon">
                        {% if credential.authenticator_info.is_some() %}
                            {% if let Some(auth_info) = credential.authenticator_info.as_ref() %}
                                <strong>{{ auth_info.name }}</strong>
                                {% if let Some(icon_url) = auth_info.icon_light.as_ref() %}
                                    <img src="{{ icon_url }}"
                                         alt="{{ auth_info.name }}"
                                         class="authenticator-icon"
                                         title="{{ auth_info.name }}">
                                {% endif %}
                            {% endif %}
                        {% endif %}
                    </div>
                    <div class="item-detail"><strong>User ID:</strong> {{ credential.user_id }}</div>
                    <div class="item-detail"><strong>Credential ID:</strong> {{ credential.credential_id }}</div>
                    <div class="item-detail"><strong>User Handle:</strong> {{ credential.user_handle }}</div>
                    <div class="item-detail"><strong>User Name:</strong>
                        {{ credential.user_name }}
                    </div>
                    <div class="item-detail"><strong>Display Name:</strong>
                        {{ credential.user_display_name }}
                    </div>
                    <div class="item-detail"><strong>AAGUID:</strong>{{ credential.aaguid }}</div>
                    {% if credential.rp_id != "" %}
                    <div class="item-detail"><strong>RP ID:</strong> {{ credential.rp_id }}</div>
                    {% else %}
                    <div class="item-detail"><strong>RP ID:</strong> (unknown)</div>
                    {% endif %}
                    <div class="item-detail"><strong>Created:</strong> {{ credential.created_at }}</div>
                    <div class="item-detail"><strong>Updated:</strong> {{ credential.updated_at }}</div>
                    <div class="item-detail  created-row">
                        <span><strong>Last Used:</strong> {{ credential.last_used_at }}</span>
                        <div>
                            <button onclick="deletePasskeyCredential('{{ credential.credential_id }}', '{{ credential.user_id }}')" class="delete-button">Delete</button>
                        </div>
                    </div>
                </div>
            {% endfor %}
        {% endif %}
    </div>

    <!-- OAuth2 Accounts Section -->
    <div class="section">
        <div class="section-header">
            <h2 class="section-title">OAuth2 Accounts</h2>
        </div>
        {% if oauth2_accounts.is_empty() %}
            <p>You don't have any linked OAuth2 accounts yet.</p>
        {% else %}
            {% for account in oauth2_accounts %}
                <div class="item oauth2">
                    {% if account.picture != "" %}
                    <div class="account-picture">
                        <img src="{{ account.picture }}" alt="Profile Picture" style="max-width: 100px; max-height: 100px; border-radius: 50%;">
                    </div>
                    {% endif %}
                    <div class="item-detail"><strong>User ID:</strong> {{ account.user_id }}</div>
                    {% if account.email != "" %}
                        <div class="item-detail"><strong>Email:</strong> {{ account.email }}</div>
                    {% endif %}
                    <div class="item-detail"><strong>Name:</strong> {{ account.name }}</div>
                    <div class="item-detail"><strong>ID:</strong> {{ account.id }}</div>
                    <div class="item-detail"><strong>Provider User ID:</strong> {{ account.provider_user_id }}</div>
                    {% if account.metadata_str != "" %}
                        <div class="item-detail"><strong>Metadata:</strong> {{ account.metadata_str }}</div>
                    {% endif %}
                    <div class="item-detail"><strong>Created:</strong> {{ account.created_at }}</div>
                    <div class="item-detail created-row">
                        <span><strong>Updated:</strong> {{ account.updated_at }}</span>
                        <button onclick="unlinkOAuth2Account('{{ account.provider }}', '{{ account.provider_user_id }}', '{{ account.user_id }}')" class="delete-button">Unlink</button>
                    </div>
                </div>
            {% endfor %}
        {% endif %}
    </div>

    <!-- Login History Section -->
    <div class="section">
        <div class="section-header">
            <h2 class="section-title">Login History</h2>
            <button onclick="loadLoginHistory()" class="action-button">Refresh</button>
        </div>
        <div id="login-history-container">
            <p id="login-history-loading">Loading...</p>
        </div>
    </div>
</div>

    <script src="{{o2p_route_prefix}}/admin/admin_user.js"></script>
    <script>
        // Global route prefix for API calls
        const O2P_ROUTE_PREFIX = "{{o2p_route_prefix}}";
        const accountName = "{{user.account}}";
        const userId = "{{user.id}}";
        const csrfToken = "{{csrf_token}}";

        // Fetch session count for this user
        async function fetchSessionCount() {
            try {
                const response = await fetch(`${O2P_ROUTE_PREFIX}/admin/sessions`, {
                    credentials: 'include'
                });
                if (!response.ok) {
                    throw new Error('Failed to fetch session status');
                }
                const sessions = await response.json();
                const count = sessions[userId] || 0;

                document.getElementById('session-count').textContent = count;

                // Show force logout button if user has active sessions
                const forceLogoutBtn = document.getElementById('force-logout-btn');
                if (count > 0) {
                    forceLogoutBtn.style.display = 'inline-block';
                } else {
                    forceLogoutBtn.style.display = 'none';
                }
            } catch (error) {
                console.error('Error fetching session count:', error);
                document.getElementById('session-count').textContent = 'Error';
            }
        }

        // Force logout the user
        async function forceLogout(userId) {
            if (!confirm('Are you sure you want to log out this user from all devices?')) {
                return;
            }

            try {
                const response = await fetch(`${O2P_ROUTE_PREFIX}/admin/user/${userId}/logout`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': csrfToken
                    },
                    credentials: 'include'
                });

                if (!response.ok) {
                    throw new Error('Failed to force logout user');
                }

                alert('User has been logged out from all devices.');
                fetchSessionCount(); // Refresh the session count
            } catch (error) {
                console.error('Error forcing logout:', error);
                alert('Failed to force logout user: ' + error.message);
            }
        }

        // Login History Functions
        let currentAuthenticators = {};

        function renderAuthMethodLabel(entry) {
            const authInfo = entry.aaguid ? currentAuthenticators[entry.aaguid] : null;
            if (authInfo) {
                const iconUrl = authInfo.icon_light || authInfo.icon_dark;
                const iconHtml = iconUrl
                    ? `<img src="${iconUrl}" alt="${authInfo.name}" style="width:20px;height:20px;vertical-align:middle;margin-right:4px;">`
                    : '';
                return `${iconHtml}<strong>${authInfo.name}</strong>`;
            }
            const icon = entry.auth_method === 'passkey' ? '🔑' : '🌐';
            let method = entry.auth_method === 'passkey' ? 'Passkey' : 'OAuth2';
            if (entry.provider) method += ` (${entry.provider})`;
            return `<span class="login-icon">${icon}</span> <strong>${method}</strong>`;
        }

        async function loadLoginHistory() {
            const container = document.getElementById('login-history-container');
            container.innerHTML = '<p id="login-history-loading">Loading...</p>';

            try {
                const response = await fetch(`${O2P_ROUTE_PREFIX}/admin/user/${userId}/login_history?limit=50`, {
                    credentials: 'include'
                });

                if (!response.ok) {
                    throw new Error('Failed to fetch login history');
                }

                const data = await response.json();
                const entries = data.entries;
                currentAuthenticators = data.authenticators || {};

                if (entries.length === 0) {
                    container.innerHTML = '<p>No login history available.</p>';
                    return;
                }

                let html = '<div class="login-history-list">';
                for (const entry of entries) {
                    const date = new Date(entry.timestamp).toLocaleString();
                    const status = entry.success ? '✓' : '✗';
                    const statusClass = entry.success ? 'success' : 'failure';

                    html += `
                        <div class="item login-history-entry">
                            <div class="item-detail">
                                ${renderAuthMethodLabel(entry)}
                                <span class="login-status ${statusClass}">${status}</span>
                            </div>
                            <div class="item-detail"><strong>Time:</strong> ${date}</div>
                            ${entry.email ? `<div class="item-detail"><strong>Email:</strong> ${entry.email}</div>` : ''}
                            ${entry.ip_address ? `<div class="item-detail"><strong>IP:</strong> ${entry.ip_address}</div>` : ''}
                            ${entry.user_agent ? `<div class="item-detail"><strong>User Agent:</strong> ${entry.user_agent}</div>` : ''}
                            ${entry.failure_reason ? `<div class="item-detail"><strong>Failure Reason:</strong> ${entry.failure_reason}</div>` : ''}
                        </div>
                    `;
                }
                html += '</div>';
                container.innerHTML = html;
            } catch (error) {
                console.error('Error loading login history:', error);
                container.innerHTML = '<p class="error">Failed to load login history.</p>';
            }
        }

        // Fetch session count and login history when page loads
        document.addEventListener('DOMContentLoaded', () => {
            fetchSessionCount();
            loadLoginHistory();
        });
    </script>

</body>
</html>

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link rel="stylesheet" href="{{o2p_route_prefix}}/user/o2p-base.css">
    {% if let Some(css_url) = custom_css_url %}
    <link rel="stylesheet" href="{{css_url}}">
    {% endif %}
    {% if let Some(css_vars) = custom_css_vars %}
    <style>{{css_vars|safe}}</style>
    {% endif %}
    <script src="{{o2p_route_prefix}}/oauth2/oauth2.js"></script>
    <script src="{{o2p_route_prefix}}/passkey/passkey.js"></script>
    <script>
        const O2P_ROUTE_PREFIX = '{{o2p_route_prefix}}';
        const csrfToken = "_NOT_SET_";
    </script>
</head>

<body class="login-page">
    <div class="login-card">
        <h1>Welcome</h1>
        <p class="subtitle">{{message}}</p>

        <div class="auth-section">
            <div class="auth-buttons">
                {% for p in providers %}
                <button class="btn {{p.button_class}} btn-block"
                        onclick="oauth2.openPopup('create_user_or_login', null, '{{p.name}}')">
                    Register / Sign in with {{p.display_name}}
                </button>
                {% endfor %}
            </div>
        </div>

        <div class="auth-section">
            <div class="auth-buttons">
                <button class="btn btn-passkey btn-block"
                        onclick="showRegistrationModal('create_user')">
                    Register with Passkey
                </button>
            </div>
        </div>

        <div class="auth-section">
            <div class="auth-buttons">
                <button class="btn btn-passkey btn-block"
                        onclick="startAuthentication(false)">
                    Sign in with Passkey
                </button>
            </div>
        </div>

        <p class="login-link">
            <a href="{{o2p_route_prefix}}/passkey/conditional_ui">Try Passkey Conditional UI</a>
        </p>
    </div>
</body>

</html>

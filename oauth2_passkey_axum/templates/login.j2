<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Index Page</title>

    <script>
        const O2P_ROUTE_PREFIX = '{{o2p_route_prefix}}';
        const csrfToken = "_NOT_SET_";
    </script>

    <script src="{{o2p_route_prefix}}/oauth2/oauth2.js" defer></script>
    <script src="{{o2p_route_prefix}}/passkey/passkey.js" defer></script>

    <style>
        button {
            cursor: pointer;
        }
        button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
    </style>

</head>

<body>
    <div>
        <h1>{{message}}</h1>
    </div>
    <div style="display: flex; gap: 10px; margin-top: 10px;">
        Google OAuth2:
    </div>
    <div style="display: flex; gap: 10px; margin-top: 10px;">
        <button id="oauth2-create-user" disabled>Create User</button>
        <button id="oauth2-login" disabled>Sign in</button>
        <button id="oauth2-either" disabled>Either way</button>
    </div>

    <div style="display: flex; gap: 10px; margin-top: 10px;">
        Passkey:
    </div>
    <div style="display: flex; gap: 10px; margin-top: 10px;">
        <button id="passkey-create-user" disabled>Create User</button>
        <button id="passkey-login" disabled>Sign in</button>
        or <a href="{{o2p_route_prefix}}/passkey/conditional_ui">try conditional UI</a>
    </div>

    <script>
        function enableButtons() {
            if (window.oauth2Ready && window.passkeyReady) {
                document.getElementById('oauth2-create-user').disabled = false;
                document.getElementById('oauth2-login').disabled = false;
                document.getElementById('oauth2-either').disabled = false;
                document.getElementById('passkey-create-user').disabled = false;
                document.getElementById('passkey-login').disabled = false;

                document.getElementById('oauth2-create-user').addEventListener('click', function() {
                    oauth2.openPopup('create_user');
                });
                document.getElementById('oauth2-login').addEventListener('click', function() {
                    oauth2.openPopup('login');
                });
                document.getElementById('oauth2-either').addEventListener('click', function() {
                    oauth2.openPopup('create_user_or_login');
                });
                document.getElementById('passkey-create-user').addEventListener('click', function() {
                    showRegistrationModal('create_user');
                });
                document.getElementById('passkey-login').addEventListener('click', function() {
                    startAuthentication();
                });
            }
        }
        window.onScriptsReady = enableButtons;
    </script>

</body>

</html>

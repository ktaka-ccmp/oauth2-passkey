<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Choose provider</title>
    <link rel="stylesheet" href="{{o2p_route_prefix}}/user/o2p-base.css">
    {% if let Some(css_url) = custom_css_url %}
    <link rel="stylesheet" href="{{css_url}}">
    {% endif %}
    {% if let Some(css_vars) = custom_css_vars %}
    <style>{{css_vars|safe}}</style>
    {% endif %}
</head>

<body class="login-page">
    <div class="login-card">
        <h1>Choose a provider</h1>
        <p class="subtitle">
            {% if mode == "add_to_user" %}
            Select which account to link
            {% else %}
            Choose how to sign in
            {% endif %}
        </p>

        <div class="auth-section">
            <div class="auth-buttons">
                {% for p in providers %}
                {% if post_linking_active %}
                <button type="button" class="btn {{p.button_class}} btn-block"
                        onclick="oauth2LinkSelect('{{p.provider_name}}')">
                    Continue with {{p.display_name}}
                </button>
                {% else %}
                <a class="btn {{p.button_class}} btn-block"
                   href="{{o2p_route_prefix}}/oauth2/{{p.provider_name}}?mode={{mode}}{% if context != "" %}&amp;context={{context}}{% endif %}">
                    Continue with {{p.display_name}}
                </a>
                {% endif %}
                {% endfor %}
            </div>
        </div>
    </div>

    {% if post_linking_active %}
    <script>
        // POST-based linking flow for the popup itself (parallel to
        // oauth2.linkAccountPost in static/oauth2.js, but navigates the
        // current window since this *is* the popup).
        const PREFIX = "{{o2p_route_prefix}}";
        const CSRF_TOKEN = "{{csrf_token}}";

        async function oauth2LinkSelect(provider) {
            const r = await fetch(`${PREFIX}/oauth2/${provider}`, {
                method: 'POST',
                headers: { 'X-CSRF-Token': CSRF_TOKEN },
                credentials: 'same-origin',
            });
            if (!r.ok) {
                // Mirror GET-mode behavior: replace the popup contents with
                // the raw server response body so the user can read the
                // diagnostic text (e.g. "Page session token does not match
                // session user" on session drift). Popup stays open until
                // closed manually; no auth_complete is posted, so the parent
                // does not reload.
                const text = await r.text().catch(() => `POST /oauth2/${provider} failed: ${r.status}`);
                document.body.replaceChildren(document.createTextNode(text));
                return;
            }
            const { auth_url } = await r.json();
            window.location.href = auth_url;
        }

        {% if let Some(provider) = single_provider_auto_trigger %}
        // Single-provider setup: skip the selection click and proceed directly,
        // matching the GET-mode 302 behavior from the server side.
        window.addEventListener('load', () => oauth2LinkSelect("{{provider}}"));
        {% endif %}
    </script>
    {% endif %}
</body>

</html>

######################################
### Required Environment Variables ###
######################################

# Base URL of your application (required)
ORIGIN='https://your-domain.example.com'

# OAuth2 Google Client Credentials (required)
OAUTH2_GOOGLE_CLIENT_ID='your-client-id.apps.googleusercontent.com'
OAUTH2_GOOGLE_CLIENT_SECRET='your-client-secret'

# Google OAuth2 OIDC Issuer URL (required for Google provider)
# Endpoints are discovered automatically via OIDC Discovery
# Default: 'https://accounts.google.com'
OAUTH2_ISSUER_URL='https://accounts.google.com'

# Reject (true, default) or warn (false) when display-tier claims
# (name / picture / family_name / given_name) differ between the ID
# token and the /userinfo response. Identity-tier claims
# (email / email_verified / preferred_username / hd) are always rejected
# on mismatch; this flag does not affect them. Default: true.
#OAUTH2_GOOGLE_STRICT_DISPLAY_CLAIMS=true

### Storage Configuration ###

# Cache Store Configuration (required)
# Options: memory, redis
#GENERIC_CACHE_STORE_TYPE=memory
GENERIC_CACHE_STORE_TYPE=redis
GENERIC_CACHE_STORE_URL='redis://localhost:6379'

# Data Store Configuration (required)
# Options: postgres, sqlite, mysql (mysql also works with MariaDB)
GENERIC_DATA_STORE_TYPE=postgres
GENERIC_DATA_STORE_URL='postgresql://passkey:passkey@localhost:5432/passkey'

# SQLite configuration examples (uncomment if using SQLite)
#GENERIC_DATA_STORE_TYPE=sqlite
#GENERIC_DATA_STORE_URL='sqlite:/tmp/sqlite.db'
#GENERIC_DATA_STORE_URL='sqlite:./db/sqlite/data/data.db'

# For in-memory SQLite (uncomment if using in-memory SQLite)
#GENERIC_DATA_STORE_URL='sqlite:file:memdb1?mode=memory&cache=shared'
#GENERIC_DATA_STORE_URL=':memory:'

# MySQL/MariaDB configuration examples (uncomment if using MySQL or MariaDB)
#GENERIC_DATA_STORE_TYPE=mysql
#GENERIC_DATA_STORE_URL='mysql://user:password@localhost:3306/database'
# MariaDB (same driver, typically on a different port)
#GENERIC_DATA_STORE_URL='mysql://user:password@localhost:3307/database'

######################################
### Optional OAuth2 Providers      ###
######################################

# Generic OIDC Provider — Slot 1 of 8
# (optional — enabled by setting OAUTH2_CUSTOM1_CLIENT_ID)
#
# Use these slots to enable any standards-compliant OIDC provider
# (Auth0, Keycloak, Microsoft Entra, Okta, Zitadel, AWS Cognito,
# Ory Hydra, Dex, Authelia, etc.) without a code change. Allowed
# Redirect URI at the IdP:
#   {ORIGIN}/o2p/oauth2/{NAME}/authorized
# Slots 2..8 use the same shape with prefix OAUTH2_CUSTOM2_* .. OAUTH2_CUSTOM8_*.
#
# ----- Required (always) -----
#OAUTH2_CUSTOM1_CLIENT_ID='your-client-id'
#OAUTH2_CUSTOM1_CLIENT_SECRET='your-client-secret'
# Issuer URL: OIDC discovery is fetched from {ISSUER_URL}/.well-known/openid-configuration
#OAUTH2_CUSTOM1_ISSUER_URL='https://idp.example.com'
#
# ----- Preset (optional) -----
# Set PRESET to one of 'auth0' | 'keycloak' | 'entra' to pre-populate
# DISPLAY_NAME, NAME, ICON_SLUG, BUTTON_COLOR, BUTTON_HOVER_COLOR and
# any library-side quirks (e.g. login.live.com origin for Entra). Omit
# PRESET for a bare Custom slot; then DISPLAY_NAME and NAME become
# required below. Each field can still be overridden by its env var.
#OAUTH2_CUSTOM1_PRESET=auth0
#
# ----- Required when PRESET is not set (provided by preset otherwise) -----
# Human-readable label shown on the login button (e.g. "My SSO", "Zitadel").
#OAUTH2_CUSTOM1_DISPLAY_NAME='My SSO'
# URL provider name (must match [a-z0-9_-]+ and not collide with reserved names).
# Used in /o2p/oauth2/{NAME} and stored in the DB row's `provider` column.
#OAUTH2_CUSTOM1_NAME='my-sso'
#
# ----- Optional — defaults shown -----
#OAUTH2_CUSTOM1_RESPONSE_MODE='form_post'     # form_post or query
#OAUTH2_CUSTOM1_SCOPE='openid+email+profile'
# SVG basename served at /o2p/icons/{slug}.svg. Built-ins:
#   'auth0', 'keycloak', 'entra', 'google', 'openid' (default).
#OAUTH2_CUSTOM1_ICON_SLUG='openid'
#OAUTH2_CUSTOM1_BUTTON_COLOR='#6b7280'        # inline CSS background-color
#OAUTH2_CUSTOM1_BUTTON_HOVER_COLOR='#4b5563'  # :hover state color
# Accepted color formats: '#rgb', '#rgba', '#rrggbb', '#rrggbbaa', or a
# lowercase CSS color keyword (e.g. 'red', 'tomato'). Functional forms
# such as rgb(...) / hsl(...) and uppercase keywords are rejected at
# startup to prevent CSS injection in the inline <style> block.
# Reject (true, default) or warn (false) on display-tier claim divergence
# between the ID token and /userinfo. Tier 1 (email / email_verified /
# preferred_username / hd) is always strict regardless of this flag.
#OAUTH2_CUSTOM1_STRICT_DISPLAY_CLAIMS=true
#
# ----- Examples: named IdPs via preset -----
#
# Auth0 (register a "Regular Web Application" in your Auth0 tenant):
#   OAUTH2_CUSTOM1_PRESET=auth0
#   OAUTH2_CUSTOM1_CLIENT_ID='...'
#   OAUTH2_CUSTOM1_CLIENT_SECRET='...'
#   OAUTH2_CUSTOM1_ISSUER_URL='https://your-tenant.auth0.com'
#
# Keycloak (register a "confidential" client in your realm):
#   OAUTH2_CUSTOM1_PRESET=keycloak
#   OAUTH2_CUSTOM1_CLIENT_ID='...'
#   OAUTH2_CUSTOM1_CLIENT_SECRET='...'
#   OAUTH2_CUSTOM1_ISSUER_URL='http://localhost:8180/realms/myrealm'
#
# Microsoft Entra ID (single-tenant issuer only; multi-tenant `common`/
# `organizations` endpoints are not supported because the discovery
# document returns a `{tenantid}` placeholder that fails issuer validation):
#   OAUTH2_CUSTOM1_PRESET=entra
#   OAUTH2_CUSTOM1_CLIENT_ID='...'
#   OAUTH2_CUSTOM1_CLIENT_SECRET='...'
#   OAUTH2_CUSTOM1_ISSUER_URL='https://login.microsoftonline.com/{tenant-id}/v2.0'

######################################
### Optional Environment Variables ###
######################################

# WebAuthn Configuration
# IMPORTANT: No trailing slash (/) in URLs
# Additional origins that are allowed to use your WebAuthn credentials (for multi-domain support)
# Comma-separated list of origins that share the same RP ID
# Example for single additional origin:
#WEBAUTHN_ADDITIONAL_ORIGINS='https://app.example.com'
# Example for multiple additional origins:
#WEBAUTHN_ADDITIONAL_ORIGINS='https://app.example.com,https://login.example.com,https://staging.example.com'

# Authentication Route Configuration
# Main route prefix for all authentication endpoints (oauth2, passkey, login, logout, summary)
# Default: '/o2p' (characters from 'O'auth'2' 'P'asskey)
O2P_ROUTE_PREFIX='/o2p'

# Login page URL, used by middleware/AuthUser to redirect unauthenticated users
# Set this to override the default login page URL
# Required when login-ui feature is disabled
# Default: '/o2p/user/login'
#O2P_LOGIN_URL='/o2p/user/login'

# Default redirect URL for authenticated-user flows
# Used for: authenticated users visiting login page, logout redirect target in templates
# Default: '/'
#O2P_DEFAULT_REDIRECT='/'

# Default: '/o2p/user/account'
#O2P_ACCOUNT_URL='/o2p/user/account'

# Custom CSS URL for theming authentication pages
# Built-in themes are served at {O2P_ROUTE_PREFIX}/themes/
#O2P_CUSTOM_CSS_URL=/o2p/themes/theme-zinc.css
#O2P_CUSTOM_CSS_URL=/o2p/themes/theme-slate.css
#O2P_CUSTOM_CSS_URL=/o2p/themes/theme-blue.css
#O2P_CUSTOM_CSS_URL=/o2p/themes/theme-violet.css
#O2P_CUSTOM_CSS_URL=/o2p/themes/theme-rose.css
#O2P_CUSTOM_CSS_URL=/o2p/themes/theme-neumorphism.css
#O2P_CUSTOM_CSS_URL=/o2p/themes/theme-material.css
#O2P_CUSTOM_CSS_URL=/o2p/themes/theme-eco.css
#O2P_CUSTOM_CSS_URL=/o2p/themes/theme-saas.css

# Set to true/false to enable/disable X-CSRF-Token response header
# Default: true
#O2P_RESPOND_WITH_X_CSRF_TOKEN=false

# Demo mode for public demo sites
# When enabled, masks other users' sensitive data in admin views, inserts a placeholder user,
# and grants admin privileges to all new users
# Default: false
#O2P_DEMO_MODE=false

# Login history retention in days (0 = disabled, no automatic cleanup)
# Default: 0
#O2P_LOGIN_HISTORY_RETENTION_DAYS=90

# OAuth2 Endpoint Overrides (optional)
# These endpoints are automatically discovered from OAUTH2_ISSUER_URL via OIDC Discovery.
# Only set these if you need to override the discovered endpoints for specific providers.

# Override authorization endpoint (discovered from issuer if not set)
#OAUTH2_AUTH_URL='https://accounts.google.com/o/oauth2/v2/auth'

# Override token endpoint (discovered from issuer if not set)
#OAUTH2_TOKEN_URL='https://oauth2.googleapis.com/token'

# OAuth2 Parameters

# Default: 'openid+email+profile'
#OAUTH2_SCOPE='openid+email+profile'

# Default: 'form_post' (Options: form_post, query)
#OAUTH2_RESPONSE_MODE='form_post'

# Note on OAUTH2_RESPONSE_MODE: form_post mode uses SameSite=None for CSRF cookies and only enables POST callback endpoint
# query mode uses SameSite=Lax for CSRF cookies and only enables GET callback endpoint

# Default: 'code' (Options: code) Only support code flow.
#OAUTH2_RESPONSE_TYPE='code'

# Cookie Configuration

# Default: '__Host-CsrfId'
#OAUTH2_CSRF_COOKIE_NAME='__Host-CsrfId'

# Default: 60 seconds
#OAUTH2_CSRF_COOKIE_MAX_AGE=60

# Default: '__Host-SessionId'
#SESSION_COOKIE_NAME='__Host-SessionId'

# Default: 600 seconds
#SESSION_COOKIE_MAX_AGE=600

# Session Cookie Domain (for cross-subdomain cookies)
# Set this to enable cookie sharing across subdomains.
# Example: SESSION_COOKIE_DOMAIN='.example.com' allows cookies to be shared
# across app.example.com, api.example.com, etc.
# IMPORTANT: When using a domain attribute, the cookie name should NOT use
# the '__Host-' prefix. Change SESSION_COOKIE_NAME to a name without this prefix.
#SESSION_COOKIE_DOMAIN='.example.com'

# Session Conflict Policy
# Controls behavior when a user logs in while already having active sessions.
# Options:
#   'allow'   (default) - Permit multiple concurrent sessions
#   'replace' - Invalidate all existing sessions, create a new one
#   'reject'  - Deny login if an active session already exists
#SESSION_CONFLICT_POLICY=allow

### Passkey Configuration ###

# Relying Party Configuration

# Default: Same as ORIGIN
#PASSKEY_RP_NAME='My Application'

# Timeout Settings (in seconds)

# Default: 60 seconds - Sent to authenticator for client-side timeout
#PASSKEY_TIMEOUT=60

# Default: 60 seconds - Server-side timeout for challenge validity
#PASSKEY_CHALLENGE_TIMEOUT=60

# Authenticator Settings

# Default: 'platform'
# Options:
#   'platform' = built into device like Touch ID, Face ID, Windows Hello, Google/Apple password managers;
#   'cross-platform' = removable like YubiKey, security keys;
#   'None' = allow any type
#PASSKEY_AUTHENTICATOR_ATTACHMENT='platform'

# Default: 'required' (Options: 'required', 'preferred', 'discouraged')
# resident key = discoverable credential
#PASSKEY_RESIDENT_KEY='required'

# Default: true (Options: true, false)
#PASSKEY_REQUIRE_RESIDENT_KEY=true

# Default: 'discouraged' (Options: 'required', 'preferred', 'discouraged')
#PASSKEY_USER_VERIFICATION='discouraged'

# Default: false (Options: true, false)
#PASSKEY_USER_HANDLE_UNIQUE_FOR_EVERY_CREDENTIAL=false

# Note on PASSKEY_USER_HANDLE_UNIQUE_FOR_EVERY_CREDENTIAL: Password managers typically allow only one credential per user identifier.
# When false (default): Uses single user_handle for all credentials for a user (limits each user to have one credential per site)
# When true: Generates unique user_handle per credential (allows each user to have multiple credentials per site)

# Signal API mode for credential synchronization with authenticators (SERVER-SIDE ONLY)
# This controls which Signal APIs the client will call by modifying server response content.
# Custom page developers do NOT need to configure anything on the client side.
#
# Default: 'direct' (Options: direct, sync, direct+sync)
# - direct: signalUnknownCredential only (currently the only working API with Google Password Manager)
# - sync: signalAllAcceptedCredentials only (currently no effect on Chrome, may work with other authenticators)
# - direct+sync: both APIs (for testing future compatibility)
#
# When 'sync' is included, the server adds credential_ids to responses, triggering signalAllAcceptedCredentials.
# signalUnknownCredential is always called on login failure (regardless of this setting),
# but on credential deletion, it is only called when 'direct' is included.
#PASSKEY_SIGNAL_API_MODE=direct

######################################
### User Field Mapping Configuration ###
######################################
# These settings control how user fields are mapped between systems

# OAuth2 field mapping (defaults shown below)
# Maps to User.account -> email, User.label -> name
#OAUTH2_USER_ACCOUNT_FIELD='email'
#OAUTH2_USER_LABEL_FIELD='name'

# Passkey field mapping (defaults shown below)
# Maps to User.account -> name, User.label -> display_name
#PASSKEY_USER_ACCOUNT_FIELD='name'
#PASSKEY_USER_LABEL_FIELD='display_name'

######################################
### Security Configuration ###
######################################

# Server Secret (used for page session token HMAC signing)
# Default: random 32-byte key generated at startup (single-process only)
# For multi-process deployments, set this explicitly so all processes share the same key.
#AUTH_SERVER_SECRET='your-secret-key-here'

######################################
### Database Table Configuration ###
######################################

# Table Prefix for Database Tables
# Default: 'o2p_'
#DB_TABLE_PREFIX='o2p_'

# Custom Table Names (if you need to override defaults)

# Default: '{prefix}users'
#DB_TABLE_USERS='o2p_users'

# Default: '{prefix}passkey_credentials'
#DB_TABLE_PASSKEY_CREDENTIALS='o2p_passkey_credentials'

# Default: '{prefix}oauth2_accounts'
#DB_TABLE_OAUTH2_ACCOUNTS='o2p_oauth2_accounts'

######################################
### Experimental Features ###
######################################

# FedCM (Federated Credential Management) for OAuth2 Login (experimental)
# Uses browser-native account chooser instead of popup windows for Google OAuth2 login.
# Falls back automatically to popup flow on unsupported browsers (Safari, Firefox).
# Requires: OAUTH2_GOOGLE_CLIENT_ID must be set, and your ORIGIN must be added to
# "Authorized JavaScript Origins" in Google Cloud Console (not just Authorized Redirect URIs).
# IMPORTANT: Google does not officially support direct FedCM usage without GIS SDK.
# The ID token is delivered via front-channel (browser JS) and validated server-side
# using JWT signature verification (JWKS). Unlike the Authorization Code Flow,
# there is no server-to-server code exchange with client_secret.
# Values: true/enabled (enabled), anything else (disabled, default)
#O2P_FEDCM=true

# Passkey Promotion after OAuth2 Login (experimental)
# Prompt users to register a passkey after OAuth2 login
# Values: false (disabled, default), ask (show modal), force (skip modal)
#O2P_PASSKEY_PROMOTION=ask

######################################
### CORS Configuration ###
######################################
# For cross-origin deployments (Pattern 2: Cross-Origin Same-Site)
# Requires the "cors" feature in oauth2-passkey-axum

# Comma-separated list of allowed origins for CORS
# Example single origin:
#CORS_ALLOWED_ORIGINS='https://app.example.com'
# Example multiple origins:
#CORS_ALLOWED_ORIGINS='https://app.example.com,https://admin.example.com'

# Whether to allow credentials (cookies) in cross-origin requests
# Set to 'true' for cookie-based authentication across origins
#CORS_ALLOW_CREDENTIALS=true
